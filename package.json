{
  "name": "git-edge",
  "version": "0.3.0",
  "description": "High-level edge-compatible git operations — parsed-object cache, object-level three-way merge, and repo management utilities. Composes with git-fs-s3.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "format": "biome format --write src/ test/",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "git",
    "isomorphic-git",
    "edge",
    "serverless",
    "merge",
    "cache",
    "three-way-merge"
  ],
  "author": "Nandan Varma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandan-varma/git-edge.git"
  },
  "bugs": {
    "url": "https://github.com/nandan-varma/git-edge/issues"
  },
  "homepage": "https://github.com/nandan-varma/git-edge#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "lru-cache": "^11.5.3",
    "node-diff3": "^3.2.1"
  },
  "peerDependencies": {
    "git-fs-s3": ">=0.5.0",
    "isomorphic-git": ">=1.43.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "git-fs-s3": "^0.5.0",
    "isomorphic-git": "^1.43.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
